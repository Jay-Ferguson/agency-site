{
  "name": "agency-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowAny": [
        "sanity",
        "react"
      ]
    },
    "overrides": {
      "refractor>hast-to-hyperscript": "10.0.1",
      "refractor>lowlight": "2.9.0",
      "@types/react": "19.2.10",
      "@types/react-dom": "19.2.3"
    }
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "turbo": "^2.8.13",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "sanity": "^5.13.0"
  }
}